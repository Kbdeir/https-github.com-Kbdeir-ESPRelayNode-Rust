# Rust configuration parsing and the control loop exceed the IDF default stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
# Authenticated desktop browsers exceed the default 512-byte header buffer.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
# HTTP, Modbus, MQTT, DNS and SNTP run concurrently with bounded clients.
CONFIG_LWIP_MAX_SOCKETS=16
# Web assets live in their own partition, not in the executable.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_LITTLEFS_PAGE_SIZE=256
CONFIG_LITTLEFS_OBJ_NAME_LEN=256
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Watch idle starvation and actual control progress; timeout causes panic/reboot.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
